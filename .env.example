# Placeholder values only. IndexScout needs no .env file; these are optional overrides.

# Path to a Desktop OAuth client JSON (default: <config dir>/client_secret.json)
INDEXSCOUT_CLIENT_SECRETS=/path/to/client_secret.json

# Use a service account instead of OAuth (unattended automation)
# INDEXSCOUT_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# Restrict access to exact property identifiers (comma-separated)
# INDEXSCOUT_ALLOWED_PROPERTIES=sc-domain:example.com,https://www.example.com/

# Token store: auto (default), keyring, or file
# INDEXSCOUT_TOKEN_STORE=auto

# Config directory override (default: platform user config dir)
# INDEXSCOUT_CONFIG_DIR=/path/to/config
